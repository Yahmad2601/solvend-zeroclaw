[Unit]
Description=SolVend keypad serial bridge (ESP32 <-> ledger)
After=multi-user.target

[Service]
Type=simple
User=pi
Group=dialout
# NOTE: `pi` = your normal login user. There is no `zeroclaw` system user —
# ZeroClaw itself runs as YOU under `systemctl --user`. Change this line if your
# username is not `pi`. dialout is what grants /dev/ttyUSB0:
#   sudo usermod -aG dialout $USER   (then log out and back in)
EnvironmentFile=/etc/solvend/env
ExecStart=/usr/bin/python3 /opt/solvend/solvend-serial.py
Restart=always
RestartSec=3

# The daemon reads four digits and writes one command. Give it nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/solvend
PrivateNetwork=true          # it never touches the network — enforce that
DevicePolicy=closed
DeviceAllow=/dev/ttyUSB0 rw

[Install]
WantedBy=multi-user.target
